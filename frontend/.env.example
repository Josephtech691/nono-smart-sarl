# URL de l'API backend (locale ou Render une fois deployee)
VITE_API_URL=http://localhost:4000/api

# Connexion Google (bouton "Continuer avec Google") - meme valeur que
# GOOGLE_CLIENT_ID cote backend. Laisser vide desactive proprement le bouton.
VITE_GOOGLE_CLIENT_ID=

# --- Adresses publiques des 3 applications (facultatif : uniquement si elles sont hébergées séparément) ---
# Servent aux liens de connexion envoyés par l'administrateur (WhatsApp).
VITE_CLIENT_URL=
VITE_DRIVER_URL=
VITE_ADMIN_URL=
