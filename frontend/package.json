{
  "name": "fresh-fish-frontend",
  "version": "1.0.0",
  "description": "Frontend - Plateforme e-commerce Fresh Fish (silures frais & alevins) : applications clients, livreurs et admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:client": "cross-env APP=client vite",
    "dev:driver": "cross-env APP=driver vite",
    "dev:admin": "cross-env APP=admin vite",
    "build:client": "cross-env APP=client vite build",
    "build:driver": "cross-env APP=driver vite build",
    "build:admin": "cross-env APP=admin vite build",
    "build:apps": "npm run build:client && npm run build:driver && npm run build:admin"
  },
