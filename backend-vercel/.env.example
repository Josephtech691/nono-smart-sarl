# --- Application ---
NODE_ENV=development
PORT=4000

# URL(s) du frontend autorisee(s) en CORS. Plusieurs valeurs separees par des virgules.
FRONTEND_URL=http://localhost:5173

# --- Base de donnees ---
# IMPORTANT (specifique Vercel) : utilisez une URL de connexion "pooled"
# (PgBouncer / Prisma Accelerate), pas une connexion Postgres directe -
# indispensable en environnement serverless. Voir README.md pour le detail
# Neon / Supabase. Exemples :
#
#   Neon (pooler)   : postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&connection_limit=1
#   Supabase (pooler): postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DIRECT_URL doit pointer vers une connexion NON poolee (port 5432), utilisee
# uniquement pour les migrations (prisma migrate deploy, execute automatiquement
# au build via le script "vercel-build" du package.json).
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&connection_limit=1
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require

# --- Authentification ---
JWT_SECRET=change-moi-en-production-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d
# --- Connexion Google (bouton "Continuer avec Google") ---
# A creer sur https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=


# --- Vercel Cron (section "commandes recurrentes") ---
# Definissez cette valeur dans les variables d'environnement du projet Vercel :
# elle protege GET /api/cron/recurring-orders contre les appels non autorises.
# Vercel l'envoie automatiquement en header Authorization: Bearer <valeur>
# lorsqu'il declenche le cron. Generez une chaine aleatoire longue.
CRON_SECRET=

# --- Paiements : environnement ---
# NODE_ENV=production  -> vraies API MTN / Orange, AUCUNE simulation. Si une cle manque, le paiement
#                         affiche une erreur de developpement (liste des cles manquantes).
# NODE_ENV=development -> simulateur disponible (routes /api/payments/:id/simulate) quand les cles sont absentes.
#
# URL publique de cette API (sans slash final) : sert aux notifications des operateurs.
API_PUBLIC_URL=
# URL publique du site CLIENT (retour apres paiement Orange Money). Sinon : 1re valeur de FRONTEND_URL.
CLIENT_URL=

# --- MTN Mobile Money (Collections API) ---
# A obtenir sur https://momodeveloper.mtn.com
MTN_MOMO_API_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
# sandbox en test ; en production la valeur fournie par MTN (ex. mtncameroon)
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# Facultatif : XAF par defaut (EUR en sandbox)
MTN_MOMO_CURRENCY=

# --- Orange Money (Orange Money Web Payment API) ---
# A obtenir sur https://developer.orange.com
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/cm/v1
# Consumer Key / Consumer Secret de l'application Orange
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
# Facultatif : XAF par defaut (OUV pour l'environnement de test Orange)
ORANGE_MONEY_CURRENCY=

# --- SMS (ex: Africa's Talking, Twilio) ---
SMS_API_URL=
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=FRESHFISH

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Divers (facultatif, Phase 2) ---
MAPS_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Frais de livraison uniques (FCFA), quelle que soit la distance. Defaut : 1000.
DELIVERY_FEE=1000

# Notifications push (Firebase) : contenu JSON de la cle de compte de service, sur UNE seule ligne.
# Facultatif : sans elle, pas de push (les notifications restent dans l'application).
FIREBASE_SERVICE_ACCOUNT=
